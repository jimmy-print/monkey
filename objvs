#version 330 core
layout (location = 0) in vec3 pos;
layout (location = 1) in vec3 normal;
uniform mat4 model;
uniform mat4 view;
uniform mat4 proj;
out vec3 NORMAL;
out vec3 FRAGPOS;

void main()
{
	gl_Position = proj * view * model * vec4(pos.xyz, 1.0);
	FRAGPOS = vec3(model * vec4(pos.xyz, 1.0));
	NORMAL = mat3(transpose(inverse(model))) * normal;
}
